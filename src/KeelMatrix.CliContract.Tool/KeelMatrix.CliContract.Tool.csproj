<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>KeelMatrix.CliContract</AssemblyName>
    <RootNamespace>KeelMatrix.CliContract.Tool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clicontract</ToolCommandName>
    <PackageId>KeelMatrix.CliContract</PackageId>
    <Version>0.1.0</Version>
    <Authors>KeelMatrix</Authors>
    <Description>Detects breaking command-line interface changes from deterministic OpenCLI contracts.</Description>
    <PackageTags>dotnet-tool;cli;command-line;compatibility;contract;opencli;schema;breaking-change;ci;semver</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('..\..\icon.png')">icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/KeelMatrix/CliContract</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/KeelMatrix/CliContract</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KeelMatrix.CliContract.Core\KeelMatrix.CliContract.Core.csproj" />
    <PackageReference Include="KeelMatrix.Telemetry" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="**/.env*;**/*appsettings*.json;**/*telemetry*.json;**/*.local.json;**/*.local.yaml;**/*.local.yml;**/*secret*;**/*credential*;**/*.key;**/*.pfx;**/*.pem;**/*.p12;**/*.log;**/logs/**;**/cache/**;**/.cache/**;**/*.nupkg;**/*.snupkg;**/*.zip;**/*.tar.gz" />
    <Content Remove="**/.env*;**/*appsettings*.json;**/*telemetry*.json;**/*.local.json;**/*.local.yaml;**/*.local.yml;**/*secret*;**/*credential*;**/*.key;**/*.pfx;**/*.pem;**/*.p12;**/*.log;**/logs/**;**/cache/**;**/.cache/**;**/*.nupkg;**/*.snupkg;**/*.zip;**/*.tar.gz" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Link="icon.png" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>
  <PropertyGroup>
    <_CanonicalRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</_CanonicalRepositoryRoot>
    <_PackageBuildStartupDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildStartupDirectory)'))</_PackageBuildStartupDirectory>
  </PropertyGroup>
  <Target Name="ValidatePackageBuildContext" BeforeTargets="_IntermediatePack;GenerateNuspec">
    <Error Condition="'$(_PackageBuildStartupDirectory)' != '$(_CanonicalRepositoryRoot)'" Text="Package builds must start from the canonical repository root '$(_CanonicalRepositoryRoot)'; build context '$(_PackageBuildStartupDirectory)' is unsupported." />
  </Target>
  <Target Name="NormalizePackageArchives" AfterTargets="Pack">
    <PropertyGroup>
      <_PackageArchiveNormalizer>$(MSBuildProjectDirectory)/../../scripts/normalize-package-archive.ps1</_PackageArchiveNormalizer>
      <_PackageArchivePath>$(PackageOutputPath)/$(PackageId).$(PackageVersion).nupkg</_PackageArchivePath>
      <_SymbolPackageArchivePath Condition="'$(IncludeSymbols)' == 'true'">$(PackageOutputPath)/$(PackageId).$(PackageVersion).snupkg</_SymbolPackageArchivePath>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(_PackageArchiveNormalizer)&quot; -PackagePath &quot;$(_PackageArchivePath)&quot; -SymbolPackagePath &quot;$(_SymbolPackageArchivePath)&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot;" />
  </Target>
</Project>
