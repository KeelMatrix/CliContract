        "version": "1",
        "license": { "name": "MIT", "spdxId": "MIT", "url": "https://example.test/license" },
        "contact": { "name": "Support", "email": "support@example.test", "url": "https://example.test/support" }
      },
      "install": [{ "name": "dotnet", "command": "dotnet tool install tool", "description": "Install the tool" }],
      "global": {
        "exitCodes": [{ "code": 0, "status": "OK", "summary": "Success", "description": "Completed" }],
        "config": { "json": "tool.json", "toml": "tool.toml", "yaml": "tool.yaml" },
        "flags": [{ "name": "verbose", "type": "boolean", "aliases": ["v"], "default": false }]
      },
      "commands": {
        "tool": {
          "kind": "action",
          "aliases": ["t"],
          "hidden": false,
          "exitCodes": [{ "code": 1, "status": "INTERNAL_CLI_ERROR", "summary": "Failure" }],
          "examples": [{ "title": "Run", "content": "tool" }],
          "args": [{ "name": "target", "type": "string", "summary": "Target", "passthrough": true }],
          "flags": [{ "name": "count", "type": "integer", "choices": [{ "value": 1, "description": "One" }, { "value": 2 }], "alternativeSources": [{ "type": "$ENV", "property": "COUNT" }] }]
        }
      },
      "x-vendor": { "ignored": true }
    }
  },
